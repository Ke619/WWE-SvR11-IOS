diff --git a/src/core/external_frame.cpp b/src/core/external_frame.cpp
new file mode 100644
index 0000000..ca71015
--- /dev/null
+++ b/src/core/external_frame.cpp
@@ -0,0 +1,61 @@
+// [svr2011] See rex/external_frame.h.
+
+#include <rex/external_frame.h>
+
+#include <atomic>
+#include <mutex>
+
+namespace rex::external_frame {
+
+namespace {
+std::mutex g_mutex;
+Provider g_provider;
+std::atomic<bool> g_host_drawing_disabled{false};
+std::atomic<void*> g_device{nullptr};
+VulkanDevice g_vulkan_device;
+std::atomic<bool> g_vulkan_device_set{false};
+D3D11Device g_d3d11_device;
+std::atomic<bool> g_d3d11_device_set{false};
+}  // namespace
+
+void SetD3D11Device(const D3D11Device* device) {
+  if (device) g_d3d11_device = *device;
+  g_d3d11_device_set = device != nullptr;
+}
+
+const D3D11Device* GetD3D11Device() { return g_d3d11_device_set ? &g_d3d11_device : nullptr; }
+
+void SetVulkanDevice(const VulkanDevice* device) {
+  if (device) g_vulkan_device = *device;
+  g_vulkan_device_set = device != nullptr;
+}
+
+const VulkanDevice* GetVulkanDevice() { return g_vulkan_device_set ? &g_vulkan_device : nullptr; }
+
+void SetDevice(void* d3d12_device) { g_device = d3d12_device; }
+
+void* Device() { return g_device.load(); }
+
+void SetProvider(Provider provider) {
+  std::lock_guard lock(g_mutex);
+  g_provider = std::move(provider);
+}
+
+bool GetFrame(Frame& frame) {
+  std::lock_guard lock(g_mutex);
+  return g_provider && g_provider(frame);
+}
+
+void SetHostDrawingDisabled(bool disabled) { g_host_drawing_disabled = disabled; }
+
+bool HostDrawingDisabled() { return g_host_drawing_disabled.load(std::memory_order_relaxed); }
+
+namespace {
+std::atomic<uint64_t> g_swaps{0};
+}  // namespace
+
+void CountSwap() { g_swaps.fetch_add(1, std::memory_order_relaxed); }
+
+uint64_t SwapCount() { return g_swaps.load(std::memory_order_relaxed); }
+
+}  // namespace rex::external_frame
diff --git a/src/core/fiber_posix.cpp b/src/core/fiber_posix.cpp
index 4fe1ca6..3fa5fa0 100644
--- a/src/core/fiber_posix.cpp
+++ b/src/core/fiber_posix.cpp
@@ -23,10 +23,87 @@
 
 #include <cassert>
 
+#if REX_PLATFORM_ANDROID
+// [svr2011] Android (bionic has no getcontext / makecontext / swapcontext):
+// an arm64 switch of the callee-saved registers. rex_fiber_switch(&from_sp,
+// to_sp) pushes x19-x30 and d8-d15, saves sp, loads to_sp and pops the same
+// frame, returning into the other fiber (a new one "returns" to its entry).
+static_assert(sizeof(void*) == 8, "arm64 only");
+extern "C" void rex_fiber_switch(void** from_sp, void* to_sp);
+__asm__(
+    ".text\n"
+    ".p2align 4\n"
+    ".globl rex_fiber_switch\n"
+    ".type rex_fiber_switch, %function\n"
+    "rex_fiber_switch:\n"
+    "  sub sp, sp, #160\n"
+    "  stp x19, x20, [sp, #0]\n"
+    "  stp x21, x22, [sp, #16]\n"
+    "  stp x23, x24, [sp, #32]\n"
+    "  stp x25, x26, [sp, #48]\n"
+    "  stp x27, x28, [sp, #64]\n"
+    "  stp x29, x30, [sp, #80]\n"
+    "  stp d8, d9, [sp, #96]\n"
+    "  stp d10, d11, [sp, #112]\n"
+    "  stp d12, d13, [sp, #128]\n"
+    "  stp d14, d15, [sp, #144]\n"
+    "  mov x2, sp\n"
+    "  str x2, [x0]\n"
+    "  mov sp, x1\n"
+    "  ldp x19, x20, [sp, #0]\n"
+    "  ldp x21, x22, [sp, #16]\n"
+    "  ldp x23, x24, [sp, #32]\n"
+    "  ldp x25, x26, [sp, #48]\n"
+    "  ldp x27, x28, [sp, #64]\n"
+    "  ldp x29, x30, [sp, #80]\n"
+    "  ldp d8, d9, [sp, #96]\n"
+    "  ldp d10, d11, [sp, #112]\n"
+    "  ldp d12, d13, [sp, #128]\n"
+    "  ldp d14, d15, [sp, #144]\n"
+    "  add sp, sp, #160\n"
+    "  ret\n"
+    ".size rex_fiber_switch, .-rex_fiber_switch\n");
+#endif
+
 namespace rex::thread {
 
 thread_local Fiber* Fiber::tls_current_ = nullptr;
 
+#if REX_PLATFORM_ANDROID
+Fiber* Fiber::ConvertCurrentThread() {
+  auto* f = new Fiber();  // (its sp_ is set by the first switch away)
+  f->is_thread_fiber_ = true;
+  tls_current_ = f;
+  return f;
+}
+
+Fiber* Fiber::Create(size_t stack_size, void (*entry)(void*), void* arg) {
+  auto* f = new Fiber();
+  f->entry_ = entry;
+  f->arg_ = arg;
+  f->stack_.resize(stack_size);
+  // The frame rex_fiber_switch pops: zeroes, and x30 (at +88) the entry.
+  uintptr_t top = (reinterpret_cast<uintptr_t>(f->stack_.data()) + stack_size) & ~uintptr_t(15);
+  auto* frame = reinterpret_cast<uint64_t*>(top - 160);
+  for (int i = 0; i < 20; ++i) frame[i] = 0;
+  frame[11] = reinterpret_cast<uint64_t>(&Fiber::Trampoline);
+  f->sp_ = frame;
+  return f;
+}
+
+/*static*/ void Fiber::Trampoline() {
+  Fiber* f = tls_current_;
+  f->entry_(f->arg_);
+  __builtin_trap();  // (a fiber's entry never returns)
+}
+
+void Fiber::SwitchTo(Fiber* target) {
+  Fiber* from = tls_current_;
+  tls_current_ = target;
+  rex_fiber_switch(&from->sp_, target->sp_);
+}
+#else
+
 Fiber* Fiber::ConvertCurrentThread() {
   auto* f = new Fiber();
   if (getcontext(&f->context_) == -1) {
@@ -67,6 +144,7 @@ void Fiber::SwitchTo(Fiber* target) {
   tls_current_ = target;
   swapcontext(&from->context_, &target->context_);

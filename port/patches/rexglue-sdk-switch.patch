+namespace rex::filesystem {
+
+// The game's folder: the card's listing in one request per 64 entries, then what only the
+// NSP has (the card's file wins). Timestamps are left at 0: nothing here reads them.
+static bool ListFilesFast(const std::filesystem::path& path, std::vector<FileInfo>& result) {
+  struct Ctx {
+    const std::filesystem::path* path;
+    std::vector<FileInfo>* out;
+  } ctx{&path, &result};
+  auto add = [](void* user, const char* name, bool folder, uint64_t size) {
+    auto* c = static_cast<Ctx*>(user);
+    FileInfo info;
+    info.name = name;
+    info.path = *c->path;
+    info.create_timestamp = info.access_timestamp = info.write_timestamp = convertUnixtimeToWinFiletime(0);
+    info.type = folder ? FileInfo::Type::kDirectory : FileInfo::Type::kFile;
+    info.total_size = folder ? 0 : size;
+    c->out->push_back(info);
+  };
+  if (!NxListSdFolder(path.c_str(), add, &ctx)) return false;
+  static const std::string kGame = "/SvR2011";
+  const std::string text = path.string();
+  if (text.compare(0, kGame.size(), kGame) != 0 || (text.size() > kGame.size() && text[kGame.size()] != '/')) return true;
+  const std::string in_nsp = "romfs:/game" + text.substr(kGame.size());
+  DIR* dir = opendir(in_nsp.c_str());
+  if (!dir) return true;
+  while (auto ent = readdir(dir)) {
+    if (strcmp(ent->d_name, ".") == 0 || strcmp(ent->d_name, "..") == 0) continue;
+    bool have = false;
+    for (const auto& known : result) {
+      if (known.name == std::filesystem::path(ent->d_name)) {
+        have = true;
+        break;
+      }
+    }
+    if (have) continue;
+    struct stat st {};
+    stat((in_nsp + "/" + ent->d_name).c_str(), &st);
+    add(&ctx, ent->d_name, ent->d_type == DT_DIR, static_cast<uint64_t>(st.st_size));
+  }
+  closedir(dir);
+  return true;
+}
+#endif

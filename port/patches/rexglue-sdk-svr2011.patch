@@ -0,0 +1,221 @@
+// [svr2011] Direct3D 11 graphics provider (rex/ui/d3d11/d3d11_provider.h).
+
+#include <rex/ui/d3d11/d3d11_provider.h>
+
+#include <iterator>
+#include <string>
+#include <vector>
+
+#include <dxgi1_6.h>
+
+#include <rex/cvar.h>
+#include <rex/external_frame.h>
+#include <rex/logging.h>
+#include <rex/ui/d3d11/d3d11_immediate_drawer.h>
+#include <rex/ui/d3d11/d3d11_presenter.h>
+
+REXCVAR_DEFINE_BOOL(d3d11_debug, false, "UI/D3D11", "Enable the Direct3D 11 debug layer")
+    .lifecycle(rex::cvar::Lifecycle::kInitOnly);
+REXCVAR_DEFINE_INT32(d3d11_adapter, -1, "UI/D3D11",
+                     "Index of the DXGI adapter to use (-1 for the high-performance physical GPU, "
+                     "-2 for WARP, the software rasterizer)")
+    .lifecycle(rex::cvar::Lifecycle::kInitOnly);
+REXCVAR_DEFINE_INT32(d3d11_feature_level, 0, "UI/D3D11",
+                     "Highest Direct3D feature level to use (0 for the GPU's highest; 110 for 11_0, "
+                     "101 for 10_1, 100 for 10_0 - to test what older GPUs get)")
+    .lifecycle(rex::cvar::Lifecycle::kInitOnly);
+
+namespace rex::ui::d3d11 {
+
+namespace {
+
+const char* FeatureLevelName(D3D_FEATURE_LEVEL level) {
+  switch (level) {
+    case D3D_FEATURE_LEVEL_12_1:
+      return "12_1";
+    case D3D_FEATURE_LEVEL_12_0:
+      return "12_0";
+    case D3D_FEATURE_LEVEL_11_1:
+      return "11_1";
+    case D3D_FEATURE_LEVEL_11_0:
+      return "11_0";
+    case D3D_FEATURE_LEVEL_10_1:
+      return "10_1";
+    case D3D_FEATURE_LEVEL_10_0:
+      return "10_0";
+    default:
+      return "9_x";
+  }
+}
+
+}  // namespace
+
+bool D3D11Provider::IsD3D11APIAvailable() {
+  HMODULE library = LoadLibraryW(L"d3d11.dll");
+  if (!library) {
+    return false;
+  }
+  FreeLibrary(library);
+  return true;
+}
+
+std::unique_ptr<D3D11Provider> D3D11Provider::Create() {
+  std::unique_ptr<D3D11Provider> provider(new D3D11Provider);
+  if (!provider->Initialize()) {
+    REXLOG_ERROR("D3D11Provider: no Direct3D 11 device (feature level 10_0 or newer) could be created");
+    return nullptr;
+  }
+  return provider;
+}
+
+D3D11Provider::~D3D11Provider() {
+  rex::external_frame::SetD3D11Device(nullptr);
+  if (context_) {
+    std::lock_guard lock(context_mutex_);
+    context_->ClearState();
+    context_->Flush();
+  }
+}
+
+std::unique_ptr<Presenter> D3D11Provider::CreatePresenter(
+    Presenter::HostGpuLossCallback host_gpu_loss_callback) {
+  return D3D11Presenter::Create(host_gpu_loss_callback, *this);
+}
+
+std::unique_ptr<ImmediateDrawer> D3D11Provider::CreateImmediateDrawer() {
+  return D3D11ImmediateDrawer::Create(*this);
+}
+
+bool D3D11Provider::Initialize() {
+  if (FAILED(CreateDXGIFactory1(IID_PPV_ARGS(&dxgi_factory_)))) {
+    REXLOG_ERROR("D3D11Provider: Failed to create a DXGI factory");
+    return false;
+  }
+  dxgi_factory_.As(&dxgi_factory_2_);
+
+  // The feature levels to try, highest first, capped by d3d11_feature_level.
+  static const D3D_FEATURE_LEVEL kLevels[] = {D3D_FEATURE_LEVEL_11_1, D3D_FEATURE_LEVEL_11_0,
+                                              D3D_FEATURE_LEVEL_10_1, D3D_FEATURE_LEVEL_10_0};
+  size_t first_level = 0;
+  switch (REXCVAR_GET(d3d11_feature_level)) {
+    case 110:
+      first_level = 1;
+      break;
+    case 101:
+      first_level = 2;
+      break;
+    case 100:
+      first_level = 3;
+      break;
+    default:
+      break;
+  }
+
+  UINT flags = D3D11_CREATE_DEVICE_BGRA_SUPPORT;
+  if (REXCVAR_GET(d3d11_debug)) {
+    flags |= D3D11_CREATE_DEVICE_DEBUG;
+  }
+
+  auto create = [&](IDXGIAdapter* adapter, D3D_DRIVER_TYPE type) -> bool {
+    for (size_t first = first_level; first < std::size(kLevels); ++first) {
+      HRESULT hr = D3D11CreateDevice(adapter, type, nullptr, flags, kLevels + first,
+                                     UINT(std::size(kLevels) - first), D3D11_SDK_VERSION,
+                                     &device_, &feature_level_, &context_);
+      if (SUCCEEDED(hr)) {
+        return true;
+      }
+      if ((flags & D3D11_CREATE_DEVICE_DEBUG) && hr == DXGI_ERROR_SDK_COMPONENT_MISSING) {
+        REXLOG_WARN("D3D11Provider: the debug layer isn't installed - creating the device without it");
+        flags &= ~UINT(D3D11_CREATE_DEVICE_DEBUG);
+        --first;
+        continue;
+      }
+      // The Windows 7 runtime without the platform update rejects 11_1 in the
+      // list (E_INVALIDARG): the loop retries from the next level down.
+      if (hr != E_INVALIDARG) {
+        return false;
+      }
+    }
+    return false;
+  };
+
+  const int32_t adapter_choice = REXCVAR_GET(d3d11_adapter);
+  bool created = false;
+  if (adapter_choice == -2) {
+    created = create(nullptr, D3D_DRIVER_TYPE_WARP);
+    is_warp_ = created;
+  } else {
+    std::vector<Microsoft::WRL::ComPtr<IDXGIAdapter1>> adapters;
+    Microsoft::WRL::ComPtr<IDXGIFactory6> factory6;
+    if (adapter_choice == -1 && SUCCEEDED(dxgi_factory_.As(&factory6))) {
+      Microsoft::WRL::ComPtr<IDXGIAdapter1> adapter;
+      for (UINT i = 0; factory6->EnumAdapterByGpuPreference(i, DXGI_GPU_PREFERENCE_HIGH_PERFORMANCE,
+                                                            IID_PPV_ARGS(&adapter)) == S_OK;
+           ++i) {
+        adapters.push_back(std::move(adapter));
+      }
+    } else {
+      Microsoft::WRL::ComPtr<IDXGIAdapter1> adapter;
+      for (UINT i = 0; dxgi_factory_->EnumAdapters1(i, &adapter) == S_OK; ++i) {
+        adapters.push_back(std::move(adapter));
+      }
+    }
+    for (size_t i = 0; i < adapters.size() && !created; ++i) {
+      DXGI_ADAPTER_DESC1 desc = {};
+      adapters[i]->GetDesc1(&desc);
+      if (adapter_choice >= 0 ? int32_t(i) != adapter_choice
+                              : (desc.Flags & DXGI_ADAPTER_FLAG_SOFTWARE) != 0) {
+        continue;
+      }
+      created = create(adapters[i].Get(), D3D_DRIVER_TYPE_UNKNOWN);
+    }
+  }
+  if (!created) {
+    return false;
+  }
+
+  context_.As(&context_1_);
+
+  // The adapter the device is on (vendor, name for the log).
+  std::string adapter_name = "?";
+  {
+    Microsoft::WRL::ComPtr<IDXGIDevice> dxgi_device;
+    Microsoft::WRL::ComPtr<IDXGIAdapter> adapter;
+    DXGI_ADAPTER_DESC desc = {};
+    if (SUCCEEDED(device_.As(&dxgi_device)) && SUCCEEDED(dxgi_device->GetAdapter(&adapter)) &&
+        SUCCEEDED(adapter->GetDesc(&desc))) {
+      adapter_vendor_id_ = GpuVendorID(desc.VendorId);
+      const int n = WideCharToMultiByte(CP_UTF8, 0, desc.Description, -1, nullptr, 0, nullptr, nullptr);
+      if (n > 1) {
+        adapter_name.resize(size_t(n - 1));
+        WideCharToMultiByte(CP_UTF8, 0, desc.Description, -1, adapter_name.data(), n, nullptr, nullptr);
+      }
+      if (desc.VendorId == 0x1414 && desc.DeviceId == 0x8C) {
+        is_warp_ = true;  // (Microsoft Basic Render Driver)
+      }
+    }
+  }
+
+  D3D11_FEATURE_DATA_D3D11_OPTIONS options = {};
+  if (SUCCEEDED(device_->CheckFeatureSupport(D3D11_FEATURE_D3D11_OPTIONS, &options,
+                                             sizeof(options)))) {
+    constant_buffer_offsetting_ = options.ConstantBufferOffsetting && context_1_;
+  }
+
+  REXLOG_INFO("D3D11Provider: {} (vendor {:04X}), feature level {}{}, constant buffer offsets {}",
+              adapter_name, uint32_t(adapter_vendor_id_), FeatureLevelName(feature_level_),
+              is_warp_ ? " (WARP)" : "", constant_buffer_offsetting_ ? "yes" : "no");
+
+  rex::external_frame::D3D11Device info;
+  info.device = device_.Get();
+  info.context = context_.Get();
+  info.context_mutex = &context_mutex_;
+  info.feature_level = uint32_t(feature_level_);
+  info.constant_buffer_offsetting = constant_buffer_offsetting_;
+  info.warp = is_warp_;
+  info.vendor_id = uint32_t(adapter_vendor_id_);
+  rex::external_frame::SetD3D11Device(&info);  // app renderers use this device
+  return true;
+}
+
+}  // namespace rex::ui::d3d11
diff --git a/src/ui/d3d11/d3d11_presenter.cpp b/src/ui/d3d11/d3d11_presenter.cpp
new file mode 100644
index 0000000..36b10eb
--- /dev/null
+++ b/src/ui/d3d11/d3d11_presenter.cpp
@@ -0,0 +1,462 @@
+// [svr2011] Direct3D 11 presenter (rex/ui/d3d11/d3d11_presenter.h).
+
+#include <rex/ui/d3d11/d3d11_presenter.h>
+
+#include <algorithm>
+#include <chrono>
+#include <cstring>
+
+#include <dxgi1_5.h>
+
+#include <rex/cvar.h>
+#include <rex/logging.h>
+#include <rex/ui/surface_win.h>
+
+REXCVAR_DEFINE_BOOL(d3d11_allow_tearing, true, "UI/D3D11",
+                    "Allow variable refresh rate and tearing (flip model swap chains)");
+REXCVAR_DECLARE(bool, vsync);  // (presenter.cpp; on: no tearing)
+REXCVAR_DECLARE(bool, d3d_throttle_ui_paints);  // (presenter.cpp)
+
+namespace rex::ui::d3d11 {
+
+namespace shaders {
+#include "../shaders/bytecode/d3d11_4_0/guest_output_bilinear_ps.h"
+#include "../shaders/bytecode/d3d11_4_0/guest_output_rect_vs.h"
+}  // namespace shaders
+
+namespace {
+
+// RectConstants of guest_output_rect.vs.hlsl.
+struct RectConstants {
+  float offset[2];
+  float size[2];
+};
+
+}  // namespace
+
+std::unique_ptr<D3D11Presenter> D3D11Presenter::Create(HostGpuLossCallback host_gpu_loss_callback,
+                                                       const D3D11Provider& provider) {
+  std::unique_ptr<D3D11Presenter> presenter(new D3D11Presenter(host_gpu_loss_callback, provider));
+  if (!presenter->InitializeSurfaceIndependent()) {
+    return nullptr;
+  }
+  return presenter;
+}
+
+D3D11Presenter::~D3D11Presenter() { DestroySwapChain(); }
+
+Surface::TypeFlags D3D11Presenter::GetSupportedSurfaceTypes() const {
+  return Surface::kTypeFlag_Win32Hwnd;
+}
+
+bool D3D11Presenter::InitializeSurfaceIndependent() {
+  {
+    Microsoft::WRL::ComPtr<IDXGIFactory5> factory5;
+    BOOL tearing = FALSE;
+    dxgi_supports_tearing_ =
+        SUCCEEDED(provider_.GetDXGIFactory()->QueryInterface(IID_PPV_ARGS(&factory5))) &&
+        SUCCEEDED(factory5->CheckFeatureSupport(DXGI_FEATURE_PRESENT_ALLOW_TEARING, &tearing,
+                                                sizeof(tearing))) &&
+        tearing;
+  }
+
+  ID3D11Device* device = provider_.GetDevice();
+  if (FAILED(device->CreateVertexShader(shaders::guest_output_rect_vs,
+                                        sizeof(shaders::guest_output_rect_vs), nullptr,
+                                        &rect_vs_)) ||
+      FAILED(device->CreatePixelShader(shaders::guest_output_bilinear_ps,
+                                       sizeof(shaders::guest_output_bilinear_ps), nullptr,
+                                       &bilinear_ps_))) {
+    REXLOG_ERROR("D3D11Presenter: Failed to create the guest output shaders");
+    return false;
+  }
+  D3D11_SAMPLER_DESC sampler = {};
+  sampler.Filter = D3D11_FILTER_MIN_MAG_MIP_LINEAR;
+  sampler.AddressU = sampler.AddressV = sampler.AddressW = D3D11_TEXTURE_ADDRESS_CLAMP;
+  sampler.MaxAnisotropy = 1;
+  sampler.ComparisonFunc = D3D11_COMPARISON_NEVER;
+  D3D11_BLEND_DESC blend = {};
+  blend.RenderTarget[0].RenderTargetWriteMask = D3D11_COLOR_WRITE_ENABLE_ALL;
+  D3D11_RASTERIZER_DESC raster = {};
+  raster.FillMode = D3D11_FILL_SOLID;
+  raster.CullMode = D3D11_CULL_NONE;
+  raster.DepthClipEnable = TRUE;
+  D3D11_DEPTH_STENCIL_DESC depth = {};
+  D3D11_BUFFER_DESC constants = {};
+  constants.ByteWidth = 16;
+  constants.Usage = D3D11_USAGE_DYNAMIC;
+  constants.BindFlags = D3D11_BIND_CONSTANT_BUFFER;
+  constants.CPUAccessFlags = D3D11_CPU_ACCESS_WRITE;
+  if (FAILED(device->CreateSamplerState(&sampler, &linear_clamp_)) ||
+      FAILED(device->CreateBlendState(&blend, &blend_opaque_)) ||
+      FAILED(device->CreateRasterizerState(&raster, &rasterizer_)) ||
+      FAILED(device->CreateDepthStencilState(&depth, &depth_off_)) ||
+      FAILED(device->CreateBuffer(&constants, nullptr, &rect_constants_))) {
+    REXLOG_ERROR("D3D11Presenter: Failed to create the painting state");
+    return false;
+  }
+  return InitializeCommonSurfaceIndependent();
+}
+
+void D3D11Presenter::DestroySwapChain() {
+  if (!swap_chain_) {
+    return;
+  }
+  {
+    std::lock_guard lock(provider_.context_mutex());
+    provider_.GetContext()->ClearState();
+    back_buffer_rtv_.Reset();
+    provider_.GetContext()->Flush();
+  }
+  swap_chain_.Reset();
+  if (frame_latency_waitable_) {
+    CloseHandle(frame_latency_waitable_);
+    frame_latency_waitable_ = nullptr;
+  }
+  swap_chain_width_ = 0;
+  swap_chain_height_ = 0;
+  swap_chain_flags_ = 0;
+  swap_chain_flip_ = false;
+}
+
+bool D3D11Presenter::GetBackBufferRTV() {
+  // Buffer 0 is always the current back buffer in Direct3D 11, flip model too.
+  Microsoft::WRL::ComPtr<ID3D11Texture2D> buffer;
+  if (FAILED(swap_chain_->GetBuffer(0, IID_PPV_ARGS(&buffer))) ||
+      FAILED(provider_.GetDevice()->CreateRenderTargetView(buffer.Get(), nullptr,
+                                                           &back_buffer_rtv_))) {
+    REXLOG_ERROR("D3D11Presenter: Failed to get the swap chain's back buffer");
+    return false;
+  }
+  return true;
+}
+
+Presenter::SurfacePaintConnectResult D3D11Presenter::ConnectOrReconnectPaintingToSurfaceFromUIThread(
+    Surface& new_surface, uint32_t new_surface_width, uint32_t new_surface_height,
+    bool was_paintable, bool& is_vsync_implicit_out) {
+  // VSync on: Present waits for the refresh, so the presenter paints from the
+  // UI thread (not the guest output's). A change applies at the next connect.
+  vsync_ = REXCVAR_GET(vsync);
+  is_vsync_implicit_out = vsync_;
+  const uint32_t width =
+      std::min(new_surface_width, uint32_t(D3D11_REQ_TEXTURE2D_U_OR_V_DIMENSION));
+  const uint32_t height =
+      std::min(new_surface_height, uint32_t(D3D11_REQ_TEXTURE2D_U_OR_V_DIMENSION));
+
+  if (swap_chain_) {
+    if (was_paintable && swap_chain_width_ == width && swap_chain_height_ == height) {
+      return SurfacePaintConnectResult::kSuccessUnchanged;
+    }
+    bool resized;
+    {
+      std::lock_guard lock(provider_.context_mutex());
+      provider_.GetContext()->ClearState();
+      back_buffer_rtv_.Reset();
+      resized = SUCCEEDED(swap_chain_->ResizeBuffers(0, UINT(width), UINT(height),
+                                                     DXGI_FORMAT_UNKNOWN, swap_chain_flags_)) &&
+                GetBackBufferRTV();
+    }
+    if (resized) {
+      swap_chain_width_ = width;
+      swap_chain_height_ = height;
+      return SurfacePaintConnectResult::kSuccess;
+    }
+    REXLOG_ERROR("D3D11Presenter: Failed to resize the swap chain - creating a new one");
+    DestroySwapChain();
+  }
+
+  if (new_surface.GetType() != Surface::kTypeIndex_Win32Hwnd) {
+    REXLOG_ERROR("D3D11Presenter: unsupported surface type");
+    return SurfacePaintConnectResult::kFailureSurfaceUnusable;
+  }
+  HWND hwnd = static_cast<const Win32HwndSurface&>(new_surface).hwnd();
+  ID3D11Device* device = provider_.GetDevice();
+
+  // The flip model (Windows 10: FLIP_DISCARD, Windows 8: FLIP_SEQUENTIAL),
+  // else the blt model (Windows 7).
+  if (IDXGIFactory2* factory2 = provider_.GetDXGIFactory2()) {
+    DXGI_SWAP_CHAIN_DESC1 desc = {};
+    desc.Width = UINT(width);
+    desc.Height = UINT(height);
+    desc.Format = kSwapChainFormat;
+    desc.SampleDesc.Count = 1;
+    desc.BufferUsage = DXGI_USAGE_RENDER_TARGET_OUTPUT;
+    desc.BufferCount = 2;
+    desc.Scaling = DXGI_SCALING_NONE;
+    desc.AlphaMode = DXGI_ALPHA_MODE_IGNORE;
+    for (DXGI_SWAP_EFFECT effect : {DXGI_SWAP_EFFECT_FLIP_DISCARD, DXGI_SWAP_EFFECT_FLIP_SEQUENTIAL}) {
+      desc.SwapEffect = effect;
+      desc.Flags = effect == DXGI_SWAP_EFFECT_FLIP_DISCARD && dxgi_supports_tearing_ &&
+                           REXCVAR_GET(d3d11_allow_tearing)
+                       ? DXGI_SWAP_CHAIN_FLAG_ALLOW_TEARING
+                       : 0;
+      Microsoft::WRL::ComPtr<IDXGISwapChain1> swap_chain_1;
+      // (Windows 8.1+: a waitable swap chain, see frame_latency_waitable_)
+      desc.Flags |= DXGI_SWAP_CHAIN_FLAG_FRAME_LATENCY_WAITABLE_OBJECT;
+      HRESULT hr = factory2->CreateSwapChainForHwnd(device, hwnd, &desc, nullptr, nullptr,
+                                                    &swap_chain_1);
+      if (FAILED(hr)) {
+        desc.Flags &= ~UINT(DXGI_SWAP_CHAIN_FLAG_FRAME_LATENCY_WAITABLE_OBJECT);
+        hr = factory2->CreateSwapChainForHwnd(device, hwnd, &desc, nullptr, nullptr, &swap_chain_1);
+      }
+      if (FAILED(hr) && desc.Scaling == DXGI_SCALING_NONE) {
+        desc.Scaling = DXGI_SCALING_STRETCH;  // (Windows 8 has no SCALING_NONE)
+        hr = factory2->CreateSwapChainForHwnd(device, hwnd, &desc, nullptr, nullptr, &swap_chain_1);
+      }
+      if (SUCCEEDED(hr)) {
+        swap_chain_ = swap_chain_1;
+        swap_chain_flags_ = desc.Flags;
+        swap_chain_flip_ = true;
+        Microsoft::WRL::ComPtr<IDXGISwapChain2> swap_chain_2;
+        if ((desc.Flags & DXGI_SWAP_CHAIN_FLAG_FRAME_LATENCY_WAITABLE_OBJECT) &&
+            SUCCEEDED(swap_chain_.As(&swap_chain_2))) {
+          swap_chain_2->SetMaximumFrameLatency(2);
+          frame_latency_waitable_ = swap_chain_2->GetFrameLatencyWaitableObject();
+        }
+        break;
+      }
+    }
+  }
+  if (!swap_chain_) {
+    DXGI_SWAP_CHAIN_DESC desc = {};
+    desc.BufferDesc.Width = UINT(width);
+    desc.BufferDesc.Height = UINT(height);
+    desc.BufferDesc.Format = kSwapChainFormat;
+    desc.SampleDesc.Count = 1;
+    desc.BufferUsage = DXGI_USAGE_RENDER_TARGET_OUTPUT;
+    desc.BufferCount = 1;
+    desc.OutputWindow = hwnd;
+    desc.Windowed = TRUE;
+    desc.SwapEffect = DXGI_SWAP_EFFECT_DISCARD;
+    if (FAILED(provider_.GetDXGIFactory()->CreateSwapChain(device, &desc, &swap_chain_))) {
+      REXLOG_ERROR("D3D11Presenter: Failed to create a swap chain for the window");
+      return SurfacePaintConnectResult::kFailure;
+    }
+    swap_chain_flags_ = 0;
+    swap_chain_flip_ = false;
+  }
+  // The window implementation does borderless fullscreen itself.
+  provider_.GetDXGIFactory()->MakeWindowAssociation(hwnd, DXGI_MWA_NO_ALT_ENTER);
+
+  swap_chain_width_ = width;
+  swap_chain_height_ = height;
+  bool got_rtv;
+  {
+    std::lock_guard lock(provider_.context_mutex());
+    got_rtv = GetBackBufferRTV();
+  }
+  if (!got_rtv) {
+    DestroySwapChain();
+    return SurfacePaintConnectResult::kFailure;
+  }
+  static bool logged = false;
+  if (!logged) {
+    logged = true;
+    REXLOG_INFO("D3D11Presenter: {} swap chain{}; present: {}",
+                swap_chain_flip_ ? "flip model" : "blt model (no DXGI 1.2 flip model)",
+                (swap_chain_flags_ & DXGI_SWAP_CHAIN_FLAG_ALLOW_TEARING) ? ", tearing allowed" : "",
+                vsync_ ? "vsync (sync interval 1)" : "no vsync (sync interval 0)");
+  }
+  return SurfacePaintConnectResult::kSuccess;
+}
+
+void D3D11Presenter::DisconnectPaintingFromSurfaceFromUIThreadImpl() { DestroySwapChain(); }
+
+bool D3D11Presenter::RefreshGuestOutputImpl(
+    uint32_t mailbox_index, uint32_t frontbuffer_width, uint32_t frontbuffer_height,
+    std::function<bool(GuestOutputRefreshContext& context)> refresher, bool& is_8bpc_out_ref) {
+  GuestOutput& output = guest_outputs_[mailbox_index];
+  if (output.texture) {
+    D3D11_TEXTURE2D_DESC desc;
+    output.texture->GetDesc(&desc);
+    if (desc.Width != frontbuffer_width || desc.Height != frontbuffer_height) {
+      // (Painting holds its own references to the one it draws.)
+      output = GuestOutput();
+    }
+  }
+  if (!output.texture) {
+    D3D11_TEXTURE2D_DESC desc = {};
+    desc.Width = frontbuffer_width;
+    desc.Height = frontbuffer_height;
+    desc.MipLevels = 1;
+    desc.ArraySize = 1;
+    desc.Format = kGuestOutputFormat;
+    desc.SampleDesc.Count = 1;
+    desc.Usage = D3D11_USAGE_DEFAULT;
+    desc.BindFlags = D3D11_BIND_RENDER_TARGET | D3D11_BIND_SHADER_RESOURCE;
+    ID3D11Device* device = provider_.GetDevice();
+    if (FAILED(device->CreateTexture2D(&desc, nullptr, &output.texture)) ||
+        FAILED(device->CreateRenderTargetView(output.texture.Get(), nullptr, &output.rtv)) ||
+        FAILED(device->CreateShaderResourceView(output.texture.Get(), nullptr, &output.srv))) {
+      REXLOG_ERROR("D3D11Presenter: Failed to create the guest output {}x{} texture",
+                   frontbuffer_width, frontbuffer_height);
+      output = GuestOutput();
+      return false;
+    }
+  }
+  D3D11GuestOutputRefreshContext context(is_8bpc_out_ref, output.texture.Get(), output.rtv.Get());
+  return refresher(context);
+}

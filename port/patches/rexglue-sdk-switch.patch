diff --git a/src/core/mapped_memory_switch.cpp b/src/core/mapped_memory_switch.cpp
new file mode 100644
index 0000000..5257523
--- /dev/null
+++ b/src/core/mapped_memory_switch.cpp
@@ -0,0 +1,44 @@
+// [svr2011 switch] No mmap on Horizon: a read-mapped file is read into memory.
+#include <cstdio>
+#include <cstdlib>
+
+#include <rex/logging.h>
+#include <rex/memory/mapped_memory.h>
+
+namespace rex::memory {
+
+class HeapMappedMemory : public MappedMemory {
+ public:
+  HeapMappedMemory(void* data, size_t size) : MappedMemory(data, size) {}
+  ~HeapMappedMemory() override { std::free(data_); }
+};
+
+std::unique_ptr<MappedMemory> MappedMemory::Open(const std::filesystem::path& path, Mode mode, size_t offset,
+                                                 size_t length) {
+  if (mode != Mode::kRead) {
+    REXLOG_ERROR("Switch: writable file mapping is not supported: {}", path.string());
+    return nullptr;
+  }
+  FILE* f = std::fopen(path.string().c_str(), "rb");
+  if (!f) {
+    return nullptr;
+  }
+  std::fseek(f, 0, SEEK_END);
+  long total = std::ftell(f);
+  size_t size = length ? length : size_t(total) - offset;
+  void* data = std::malloc(size ? size : 1);
+  std::fseek(f, long(offset), SEEK_SET);
+  size_t got = data ? std::fread(data, 1, size, f) : 0;
+  std::fclose(f);
+  if (got != size) {
+    std::free(data);
+    return nullptr;
+  }
+  return std::unique_ptr<MappedMemory>(new HeapMappedMemory(data, size));
+}
+
+std::unique_ptr<ChunkedMappedMemoryWriter> ChunkedMappedMemoryWriter::Open(const std::filesystem::path&, size_t, bool) {
+  return nullptr;
+}
+
+}  // namespace rex::memory
diff --git a/src/core/memory_switch.cpp b/src/core/memory_switch.cpp
new file mode 100644
index 0000000..7fa1e2c
--- /dev/null
+++ b/src/core/memory_switch.cpp
@@ -0,0 +1,233 @@
+/**
+ * [svr2011 switch] Guest memory on Horizon (the memory_posix.cpp of the Switch).
+ *
+ * The guest address space is views of one "file": several guest ranges show the
+ * same physical pages. Horizon has no file mappings, so:
+ *  - MapFileView only records the view; the window of address space is reserved.
+ *  - Backing comes from slabs of heap, each turned into mappable code-alias
+ *    memory (svcMapProcessCodeMemory + RW), made as they are needed, so only
+ *    what the game commits is real memory.
+ *  - Committing a range gives its file offsets granules from the slabs, and maps
+ *    each granule into every view that shows that offset (svcMapProcessMemory).
+ *
+ * Measured on the console (port/docs/SWITCH_PORT_PLAN.md): one block at several
+ * addresses works, writes show through all of them; 24,000 mappings with a 32 MB
+ * system_resource_size in the NPDM; 2 MB aligned mappings are far cheaper.
+ *
+ * Page protection isn't tracked: everything mapped is read/write.
+ */
+
+#include <cstdio>
+#include <cstring>
+#include <malloc.h>
+#include <mutex>
+#include <unordered_map>
+#include <vector>
+
+#include <switch.h>
+
+#include <rex/logging.h>
+#include <rex/memory/utils.h>
+#include <rex/memory.h>
+#include <rex/platform.h>
+
+namespace rex {
+namespace memory {
+
+namespace {
+
+constexpr size_t kPage = 0x1000;
+constexpr size_t kGranule = 256 * 1024;
+constexpr size_t kSlab = 32 * 1024 * 1024;
+constexpr size_t kBlock = 2 * 1024 * 1024;
+
+struct View {
+  uint8_t* base;
+  size_t length;
+  size_t file_offset;
+};
+
+std::mutex g_lock;
+std::vector<View> g_views;
+// file offset / kGranule -> host address of the granule's memory in its slab's alias
+std::unordered_map<uint64_t, uint64_t> g_granules;
+uint64_t g_slab_next = 0, g_slab_end = 0;
+size_t g_slabs = 0, g_maps = 0;
+
+constexpr uintptr_t kHandleValue = 0x53564D;  // the only file mapping
+
+Handle Self() { return envGetOwnProcessHandle(); }
+
+bool NewSlab() {
+  void* heap = memalign(kBlock, kSlab);
+  if (!heap) {
+    REXLOG_ERROR("Switch memory: out of heap at {} slabs ({} MB)", g_slabs, g_slabs * kSlab / (1024 * 1024));
+    return false;
+  }
+  std::memset(heap, 0, kSlab);
+  virtmemLock();
+  uint64_t alias = reinterpret_cast<uint64_t>(virtmemFindCodeMemory(kSlab + kBlock, kPage));
+  alias = (alias + kBlock - 1) & ~uint64_t(kBlock - 1);
+  Result rc = svcMapProcessCodeMemory(Self(), alias, reinterpret_cast<uint64_t>(heap), kSlab);
+  virtmemUnlock();
+  if (R_SUCCEEDED(rc)) {
+    rc = svcSetProcessMemoryPermission(Self(), alias, kSlab, Perm_Rw);
+  }
+  if (R_FAILED(rc)) {
+    REXLOG_ERROR("Switch memory: slab rc={:#x}", rc);
+    return false;
+  }
+  g_slab_next = alias;
+  g_slab_end = alias + kSlab;
+  g_slabs++;
+  return true;
+}
+
+// Map [src, src+size) of a granule, for file offset `file`, into every view.
+bool MapToViews(uint64_t file, uint64_t src, size_t size) {
+  for (const View& v : g_views) {
+    uint64_t begin = std::max<uint64_t>(file, v.file_offset);
+    uint64_t end = std::min<uint64_t>(file + size, v.file_offset + v.length);
+    if (begin >= end) {
+      continue;
+    }
+    uint8_t* to = v.base + (begin - v.file_offset);
+    Result rc = svcMapProcessMemory(to, Self(), src + (begin - file), end - begin);
+    if (R_FAILED(rc)) {
+      REXLOG_ERROR("Switch memory: map {} size {:#x} rc={:#x} after {} maps", static_cast<void*>(to), end - begin,
+                   rc, g_maps);
+      return false;
+    }
+    g_maps++;
+  }
+  return true;
+}
+
+const View* ViewOf(const void* address) {
+  auto a = static_cast<const uint8_t*>(address);
+  for (const View& v : g_views) {
+    if (a >= v.base && a < v.base + v.length) {
+      return &v;
+    }
+  }
+  return nullptr;
+}
+
+bool Commit(const View& view, uint8_t* address, size_t length) {
+  uint64_t first = view.file_offset + (address - view.base);
+  uint64_t last = first + length;
+  std::lock_guard<std::mutex> lock(g_lock);
+  // View offsets may start inside a granule (E0000000 is 0x1000 in), which is fine:
+  // granules are in file offsets.
+  for (uint64_t g = first / kGranule; g <= (last - 1) / kGranule; g++) {
+    if (g_granules.count(g)) {
+      continue;
+    }
+    if (g_slab_next + kGranule > g_slab_end && !NewSlab()) {
+      return false;
+    }
+    uint64_t src = g_slab_next;
+    g_slab_next += kGranule;
+    if (!MapToViews(g * kGranule, src, kGranule)) {
+      return false;
+    }
+    g_granules[g] = src;
+  }
+  return true;
+}
+
+}  // namespace
+
+size_t page_size() { return kPage; }
+size_t allocation_granularity() { return kPage; }
+
+bool IsWritableExecutableMemorySupported() { return false; }
+bool IsWritableExecutableMemoryPreferred() { return false; }
+
+void* AllocFixed(void* base_address, size_t length, AllocationType allocation_type, PageAccess access) {
+  if (!base_address) {
+    void* mem = memalign(kPage, (length + kPage - 1) & ~(kPage - 1));
+    if (mem) {
+      std::memset(mem, 0, length);
+    }
+    return mem;
+  }
+  const View* view = ViewOf(base_address);
+  if (!view) {
+    return nullptr;
+  }
+  if (allocation_type == AllocationType::kReserve) {
+    return base_address;
+  }
+  return Commit(*view, static_cast<uint8_t*>(base_address), length) ? base_address : nullptr;
+}
+
+bool DeallocFixed(void* base_address, size_t length, DeallocationType deallocation_type) {
+  const View* view = ViewOf(base_address);
+  if (!view) {
+    if (deallocation_type == DeallocationType::kRelease) {
+      free(base_address);
+    }
+    return true;
+  }
+  // The memory stays mapped for the next commit, which must read as zero. Only
+  // whole committed granules can be touched: a reservation released unused isn't.
+  uint64_t first = view->file_offset + (static_cast<uint8_t*>(base_address) - view->base);
+  std::lock_guard<std::mutex> lock(g_lock);
+  uint64_t pos = first, end = first + length;
+  while (pos < end) {
+    uint64_t next = std::min<uint64_t>((pos / kGranule + 1) * kGranule, end);
+    auto it = g_granules.find(pos / kGranule);
+    if (it != g_granules.end()) {
+      std::memset(reinterpret_cast<void*>(it->second + (pos % kGranule)), 0, next - pos);
+    }
+    pos = next;
+  }
+  return true;
+}
+
+bool Protect(void* base_address, size_t length, PageAccess access, PageAccess* out_old_access) {
+  if (out_old_access) {
+    *out_old_access = PageAccess::kReadWrite;
+  }
+  return true;
+}
+
+bool QueryProtect(void* base_address, size_t& length, PageAccess& access_out) {
+  access_out = PageAccess::kReadWrite;
+  return true;
+}
+
+FileMappingHandle CreateFileMappingHandle(const std::filesystem::path& path, size_t length, PageAccess access,
+                                          bool commit) {
+  return static_cast<FileMappingHandle>(kHandleValue);
+}
+
+void CloseFileMappingHandle(FileMappingHandle handle, const std::filesystem::path& path) {
+  std::lock_guard<std::mutex> lock(g_lock);
+  g_views.clear();
+}
+
+void* MapFileView(FileMappingHandle handle, void* base_address, size_t length, PageAccess access,
+                  size_t file_offset) {
+  if (!base_address) {
+    return nullptr;
+  }
+  std::lock_guard<std::mutex> lock(g_lock);
+  g_views.push_back({static_cast<uint8_t*>(base_address), length, file_offset});
+  return base_address;
+}
+
+bool UnmapFileView(FileMappingHandle handle, void* base_address, size_t length) {
+  std::lock_guard<std::mutex> lock(g_lock);
+  for (auto it = g_views.begin(); it != g_views.end(); ++it) {
+    if (it->base == base_address) {
+      g_views.erase(it);
+      return true;
+    }
+  }
+  return true;
+}
+
+}  // namespace memory
+}  // namespace rex

+// [svr2011 switch] Force-included everywhere: names Linux code expects.
+#pragma once
+#if defined(__cplusplus) && !defined(_GNU_SOURCE)
+#define _GNU_SOURCE 1
+#endif
+#include <stdio.h>
+#include <sys/types.h>
+#include <time.h>
+#include <unistd.h>
+#ifndef CLOCK_MONOTONIC_RAW
+#define CLOCK_MONOTONIC_RAW CLOCK_MONOTONIC
+#endif
+typedef off_t off64_t;
+#define fseeko64 fseeko
+#define ftello64 ftello
+#define ftruncate64 ftruncate
+#define stat64 stat
+#define fstat64 fstat
+#define lseek64 lseek
+
+// newlib has no timegm.
+static inline time_t rex_nx_timegm(struct tm* t) {
+  long long y = (long long)t->tm_year + 1900;
+  int m = t->tm_mon + 1;
+  y -= m <= 2;
+  long long era = (y >= 0 ? y : y - 399) / 400;
+  unsigned yoe = (unsigned)(y - era * 400);
+  unsigned doy = (153 * (m + (m > 2 ? -3 : 9)) + 2) / 5 + t->tm_mday - 1;
+  unsigned doe = yoe * 365 + yoe / 4 - yoe / 100 + doy;
+  long long days = era * 146097 + (long long)doe - 719468;
+  return (time_t)(days * 86400 + t->tm_hour * 3600 + t->tm_min * 60 + t->tm_sec);
+}
+#define timegm rex_nx_timegm
+#define SPDLOG_NO_TZ_OFFSET 1
+#define VULKAN_HPP_ENABLE_DYNAMIC_LOADER_TOOL 0
+
+// Linux calls the game makes for its worker threads: no meaning on Horizon.
+#define PRIO_PROCESS 0
+#define SYS_gettid 0
+static inline int setpriority(int, unsigned, int) { return 0; }
+static inline long rex_nx_syscall(long, ...) { return 0; }
+#define syscall rex_nx_syscall
+static inline pid_t gettid(void) { return 0; }

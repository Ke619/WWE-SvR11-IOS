+  auto session = make_object<XSessionObject>(REX_KERNEL_STATE());
+  if (!session->Initialize()) {
+    session->ReleaseHandle();
+    return X_ERROR_FUNCTION_FAILED;
+  }
+  *handle_ptr = session->handle();
   return X_ERROR_SUCCESS;
 }
 
